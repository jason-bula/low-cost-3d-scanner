 <class>CalibrationWindow</class>
 <widget class="QDialog" name="CalibrationWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>760</width>
    <height>700</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Mount calibration</string>
  </property>
  <widget class="QWidget" name="">
   <layout class="QVBoxLayout" name="verticalLayout">
    <property name="contentsMargins">
     <number>12</number>
    </property>
    <property name="spacing">
     <number>10</number>
    </property>

    <!-- ══ Input PCAP ══ -->
    <item>
     <widget class="QGroupBox" name="groupInput">
      <property name="title">
       <string>Input data</string>
      </property>
      <layout class="QGridLayout" name="layoutInput">
       <item row="0" column="0">
        <widget class="QLabel">
         <property name="text"><string>PCAP file</string></property>
        </widget>
       </item>
       <item row="0" column="1" colspan="3">
        <widget class="QLineEdit" name="editPcap">
         <property name="text"><string>raw/scan_360_6min.pcap</string></property>
        </widget>
       </item>
       <item row="0" column="4">
        <widget class="QPushButton" name="btnBrowsePcap">
         <property name="text"><string>...</string></property>
         <property name="maximumWidth"><number>32</number></property>
        </widget>
       </item>
       <item row="0" column="5">
        <widget class="QPushButton" name="btnRecordPcap">
         <property name="text"><string>Record PCAP</string></property>
         <property name="toolTip"><string>Slow 360° scan + PCAP recording for calibration</string></property>
         <property name="styleSheet">
          <string>QPushButton { background-color: #2196F3; color: white; font-weight: bold; border-radius: 4px; padding: 4px 8px; }
QPushButton:hover { background-color: #1976D2; }
QPushButton:disabled { background-color: #9E9E9E; }</string>
         </property>
        </widget>
       </item>

       <item row="1" column="0">
        <widget class="QLabel">
         <property name="text"><string>Total angle (°)</string></property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QDoubleSpinBox" name="spinTotalAngle">
         <property name="minimum"><double>1.0</double></property>
         <property name="maximum"><double>720.0</double></property>
         <property name="value"><double>360.0</double></property>
         <property name="decimals"><number>4</number></property>
         <property name="suffix"><string> °</string></property>
        </widget>
       </item>
       <item row="1" column="2">
        <widget name="labelMinDist" class="QLabel">
         <property name="text"><string>Min dist (m)</string></property>
        </widget>
       </item>
       <item row="1" column="3">
        <widget class="QDoubleSpinBox" name="spinMinDist">
         <property name="minimum"><double>0.0</double></property>
         <property name="maximum"><double>100.0</double></property>
         <property name="value"><double>2.0</double></property>
         <property name="decimals"><number>1</number></property>
         <property name="suffix"><string> m</string></property>
        </widget>
       </item>

       <item row="2" column="0">
        <widget class="QLabel">
         <property name="text"><string>LiDAR IP</string></property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QLineEdit" name="editIP">
         <property name="text"><string>192.168.20.13</string></property>
         <property name="maximumWidth"><number>140</number></property>
        </widget>
       </item>
       <item row="2" column="2">
        <widget class="QLabel">
         <property name="text"><string>Subsample</string></property>
        </widget>
       </item>
       <item row="2" column="3">
        <widget class="QSpinBox" name="spinSubsample">
         <property name="minimum"><number>1</number></property>
         <property name="maximum"><number>100</number></property>
         <property name="value"><number>10</number></property>
         <property name="prefix"><string>1/</string></property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>

